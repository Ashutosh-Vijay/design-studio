{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Design Studio",
  "version": "0.1.2",
  "identifier": "com.designstudio.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Design Studio for MuleSoft",
        "visible": false,
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 600,
        "resizable": true,
        "maximized": true,
        "focus": true,
        "decorations": false,
        "backgroundColor": "#0a0907"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "resources": [
      "resources/amf-server/**/*",
      "resources/jre/**/*"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQwOUQyODAyMjVENDQ0QTcKUldTblJOUWxBaWlkMEhnZFlYSTBhNDgyTUdwVCtvcjdqUnArYy82U2FZbENrdyt0NEM0MmUzOWQK",
      "endpoints": [
        "https://github.com/Ashutosh-Vijay/design-studio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  },
  "mainBinaryName": "Design Studio"
}
